<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<gazebo>
    <plugin name="gz::sim::systems::DiffDrive" filename = "gz-sim-diff-drive-system">
        <odom_publish_frequency>30</odom_publish_frequency>
        <left_joint>r_left_wheel_joint</left_joint>
        <right_joint>r_right_wheel_joint</right_joint>
        <wheel_separation>0.32</wheel_separation>
        <wheel_radius>0.1</wheel_radius>
        <max_linear_acceleration>2</max_linear_acceleration>
        <min_linear_acceleration>-2</min_linear_acceleration>
        <max_angular_acceleration>3</max_angular_acceleration>
        <min_angular_acceleration>-3</min_angular_acceleration>
        <max_linear_velocity>0.5</max_linear_velocity>
        <min_linear_velocity>-0.5</min_linear_velocity>
        <max_angular_velocity>2.0</max_angular_velocity>
        <min_angular_velocity>-2.0</min_angular_velocity>
        <odom_topic>odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <topic>cmd_vel</topic>
        <tf_topic>tf</tf_topic>
    </plugin>
</gazebo>

<gazebo reference="f_left_wheel">
  <mu1>0.0</mu1>
  <mu2>0.0</mu2>
</gazebo>

<gazebo reference="f_right_wheel">
  <mu1>0.0</mu1>
  <mu2>0.0</mu2>
</gazebo>

<gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>joint_states</topic>
        <joint_name>f_left_wheel_joint</joint_name>
        <joint_name>f_right_wheel_joint</joint_name>
        <joint_name>r_left_wheel_joint</joint_name>
        <joint_name>r_right_wheel_joint</joint_name>
    </plugin>
</gazebo>
<gazebo reference="laser_link">
    <material>Gazebo/Black</material>
    <sensor name="laser_link" type="gpu_lidar">
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <lidar>
            <scan>
                <horizontal>
                    <samples>360</samples>
                    <min_angle>-3.14</min_angle>
                    <max_angle>3.14</max_angle>
                </horizontal>
            </scan>
            <range>
                <min>0.3</min>
                <max>12</max>
            </range>
        </lidar>
        <topic>scan</topic>
    </sensor>
</gazebo>
    <gazebo reference="camera_link">
        <sensor name="rgbd_camera" type="rgbd_camera">
            <update_rate>15</update_rate>
            <camera>
                <camera_info_topic>camera/camera_info</camera_info_topic>
                <horizontal_fov>1.05</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>8.0</far>
                </clip>
            </camera>
            <topic>camera</topic>
        </sensor>
</gazebo>

<gazebo>
    <plugin name="gz::sim::systems::OdometryPublisher" filename = "gz-sim-odometry-publisher-system">
        <odom_frame>odom_fake</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <odom_topic>odom_fake</odom_topic>
        <tf_topic>tf</tf_topic>
    </plugin>
</gazebo>


</robot>